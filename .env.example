# Donetick API Configuration (Production)
DONETICK_BASE_URL=https://donetick.example.com
# Username/password login (JWT). The account must not have MFA enabled, and the
# instance must allow password login (not SSO-only). API tokens are not supported yet.
DONETICK_USERNAME=your_username
DONETICK_PASSWORD=your_password

# Optional: Live API Testing Configuration
# Uncomment these to run live API integration tests (pytest -m live_api)
# DONETICK_TEST_USER_ID=1

# Server Configuration
LOG_LEVEL=INFO

# Optional: Rate Limiting Configuration
# RATE_LIMIT_PER_SECOND=10
# RATE_LIMIT_BURST=10

# Optional: PyPI Publishing Token (for maintainers only)
# TWINE_USERNAME=__token__
# TWINE_PASSWORD=pypi-your-token-here
